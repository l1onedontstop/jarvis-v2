{
  "version": 3,
  "description": "QuickActions 规则 — 本地匹配，零延迟响应。与 V1 QuickActions.swift 对齐。",
  "rules": [
    {"pattern": "(几点|几号|日期|星期几|什么日子|现在几点|今天几号|今天星期几|what.*time|what.*date)", "action": "time_date", "priority": 100},
    {"pattern": "(退下|退后|退下吧|出去|你先休息|去休息|离开一下|不打扰|bye|goodbye|先走了|没事了|先退了|先撤了|你去休息吧|待机)", "action": "standby", "priority": 100},
    {"pattern": "音量.*(大|加|高|up)", "action": "volume_up", "priority": 90},
    {"pattern": "音量.*(小|减|低|down)", "action": "volume_down", "priority": 90},
    {"pattern": "(静音|mute)", "action": "volume_mute", "priority": 90},
    {"pattern": "(锁屏|lock|屏幕锁|锁定屏幕)", "action": "lock_screen", "priority": 90},
    {"pattern": "(休眠|睡眠|sleep)$", "action": "system_sleep", "priority": 90},
    {"pattern": "(截屏|截图|screenshot)", "action": "screenshot", "priority": 85},
    {"pattern": "打开\\s*(?!文件|文档)(.+)", "action": "open_app", "priority": 85},
    {"pattern": "(搜索|查一下|帮我查|搜一下)\\s*(.+)", "action": "search_web", "priority": 85},
    {"pattern": "给\\s*(.+)\\s*发微信说\\s*(.+)", "action": "send_wechat", "priority": 95},
    {"pattern": "发微信给\\s*(.+)\\s*说\\s*(.+)", "action": "send_wechat", "priority": 95},
    {"pattern": "今天(有什么|有什么)日程", "action": "today_schedule", "priority": 80},
    {"pattern": "(提醒我|设提醒|添加提醒|记一下)\\s*(.+)", "action": "add_reminder", "priority": 80},
    {"pattern": "(在吗|醒着吗|听得到吗|在不在)", "action": "presence_check", "priority": 60},
    {"pattern": "^(你是谁|你的名字|介绍一下自己|自我介绍|你叫什么)$", "action": "self_intro", "priority": 60},
    {"pattern": "^.*(放大|全屏|最大化).*(浏览器|窗口|safari|chrome).*$", "action": "browser_maximize", "priority": 80},
    {"pattern": "^.*(缩小|恢复|还原|最小化).*(浏览器|窗口|safari|chrome).*$", "action": "browser_restore", "priority": 80},
    {"pattern": "^(谢谢|辛苦了|多谢|thank|thanks|3Q|谢了)$", "action": "thanks", "priority": 70},
    {"pattern": "^(你好|哈喽|hi|hello|嘿|早上好|下午好|晚上好|晚安|早|晚上好呀)$", "action": "greeting", "priority": 70},
    {"pattern": "^(组队|编排|多agent|multi.?agent|派agent|派团队)\\s*(.*)", "action": "multi_agent", "priority": 75}
  ]
}
