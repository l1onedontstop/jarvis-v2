{
  "version": 2,
  "description": "QuickActions 规则 — 本地匹配，零延迟响应。",
  "rules": [
    {"pattern": "(几点|几号|日期|星期几|什么日子|现在几点|今天几号|今天星期几)", "action": "time_date", "priority": 100},
    {"pattern": "(退下|休息|不打扰|你先退下|下去吧|待机|退下吧)", "action": "standby", "priority": 100},
    {"pattern": "(音量大|大声点|音量小|小声点|静音|取消静音|调大音量|调小音量)", "action": "volume", "priority": 90},
    {"pattern": "(锁屏|锁定屏幕|休眠|sleep|睡觉|关屏)", "action": "system_sleep", "priority": 90},
    {"pattern": "打开\\s*(.+)", "action": "open_app", "priority": 85},
    {"pattern": "(搜索|查一下|帮我查|搜一下)\\s*(.+)", "action": "search_web", "priority": 85},
    {"pattern": "(截屏|截图|screenshot)", "action": "screenshot", "priority": 80},
    {"pattern": "^(你好|哈喽|hi|hello|嘿|早上好|下午好|晚上好|晚安)$", "action": "greeting", "priority": 70},
    {"pattern": "^(谢谢|多谢|thank|thanks|3Q)$", "action": "thanks", "priority": 70},
    {"pattern": "给\\s*(.+)\\s*发微信说\\s*(.+)", "action": "send_wechat", "priority": 95},
    {"pattern": "今天(有什么|有什么)日程", "action": "today_schedule", "priority": 80},
    {"pattern": "(提醒我|设提醒|添加提醒)\\s*(.+)", "action": "add_reminder", "priority": 80},
    {"pattern": "(在吗|醒着吗|听得到吗)", "action": "presence_check", "priority": 60},
    {"pattern": "^(你是谁|你的名字|介绍一下自己|自我介绍)$", "action": "self_intro", "priority": 60}
  ]
}
